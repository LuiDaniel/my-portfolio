{
  "name": "portafolio",
  "version": "0.1.0",
  "private": true,
  "description": "Portafolio personal de Luis Daniel: Next.js + intro 3D de un robot",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "prototype": "vite --config prototype/vite.config.js",
    "prototype:build": "vite build --config prototype/vite.config.js",
    "postinstall": "node scripts/copy-draco.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  }
}
