# Copia este archivo a .env.local y rellena lo que necesites. Sin claves, la web funciona en
# desarrollo: el formulario escribe en consola (en producción, sin Resend, pide escribir por email),
# no hay límite de envíos y la tarjeta de GitHub se oculta.

# URL pública del sitio (metadatos, sitemap, RSS)
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Límite de envíos (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Calendario de contribuciones (token de GitHub de solo lectura)
GITHUB_TOKEN=
